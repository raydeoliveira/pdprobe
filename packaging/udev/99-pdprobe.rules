# udev rules for pdprobe USB-C PD testers (Power-Z KM003C & FNIRSI FNB58/FNB48/C1)
# Install:
#   sudo cp 99-pdprobe.rules /etc/udev/rules.d/99-pdprobe.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Power-Z KM003C (0x5fc9:0x0063) — usbfs bulk & CDC-ACM PDM serial
SUBSYSTEM=="usb", ATTR{idVendor}=="5fc9", ATTR{idProduct}=="0063", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="5fc9", ATTRS{idProduct}=="0063", MODE="0660", TAG+="uaccess"

# FNIRSI FNB58 (0x2e3c:0x5558) — USB HID
SUBSYSTEM=="usb", ATTR{idVendor}=="2e3c", ATTR{idProduct}=="5558", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="5558", MODE="0660", TAG+="uaccess"

# FNIRSI FNB48P (0x2e3c:0x0049) — USB HID
SUBSYSTEM=="usb", ATTR{idVendor}=="2e3c", ATTR{idProduct}=="0049", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="0049", MODE="0660", TAG+="uaccess"

# FNIRSI FNB48 / STMicro (0x0483:0x003a) — USB HID
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="003a", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="003a", MODE="0660", TAG+="uaccess"

# FNIRSI C1 (0x0483:0x003b) — USB HID
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="003b", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="003b", MODE="0660", TAG+="uaccess"
